{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "passthrough": false,
  "gtk-layer-shell": true,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "modules-left": [
    "custom/weather",
    "custom/separator3",
    "clock",
    "custom/separator",
    "hyprland/workspaces",
    "custom/separator",
    "idle_inhibitor",
    "custom/voxtype",
    "custom/separator",
    "custom/daytrack",
  ],
  "modules-center": ["custom/media"],
  "modules-right": [
    "systemd-failed-units",
    "custom/flake-age",
    "group/tray-expander",
    "custom/gpu-usage",
    "cpu",
    "temperature",
    "memory",
    "pulseaudio#input",
    "pulseaudio#output",
    "custom/separator",
    "custom/nixos",
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "cursor": true,
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
    },
  },

  "custom/gpu-usage": {
    "exec": "$DOTFILES_DIR/scripts/waybar-gpu.sh",
    "return-type": "json",
    "interval": 3,
    "format": "{}",
    "on-click": "wezterm start --class float btop",
  },
  "custom/daytrack": {
    "exec": "$DOTFILES_DIR/scripts/daytrack.sh waybar",
    "return-type": "json",
    "interval": 30,
    "signal": 14,
    "format": "{}",
    "tooltip": true,
    "on-click": "$DOTFILES_DIR/scripts/daytrack.sh open",
    "on-click-middle": "wezterm start --class daytrack -- sh -c '$DOTFILES_DIR/scripts/daytrack.sh week; $DOTFILES_DIR/scripts/daytrack.sh projects; read -r _'",
    "on-click-right": "$DOTFILES_DIR/scripts/daytrack.sh toggle",
  },
  "custom/voxtype": {
    "exec": "voxtype status --follow --format json --icon-theme nerd-font",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "systemctl --user restart voxtype",
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false,
  },
  "custom/separator3": {
    "format": "•",
    "tooltip": false,
  },
  "custom/weather": {
    "format": "{}°",
    "tooltip": true,
    "interval": 600,
    "exec": "wttrbar --nerd",
    "return-type": "json",
  },
  "custom/nixos": {
    "format": "",
    "tooltip-format": "Launcher",
    "on-click": "rofi -show drun",
  },
  "cpu": {
    "interval": 5,
    "format": "<span color='#df6124'>cpu</span> {usage:02}%",
    "on-click": "wezterm start --class float btop",
    "states": {
      "warning": 50,
      "critical": 80,
    },
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 80,
    "format": "{temperatureC}°",
    "tooltip-format": "CPU (Tctl) {temperatureC}°C",
  },
  "systemd-failed-units": {
    "hide-on-ok": true,
    "format": "✗ {nr_failed}",
    "system": true,
    "user": true,
    "on-click": "wezterm start --class float -- sh -c 'systemctl --failed; systemctl --user --failed; read -r _'",
  },
  "custom/flake-age": {
    "exec": "$DOTFILES_DIR/scripts/waybar-flake-age.sh",
    "return-type": "json",
    "interval": 3600,
    "on-click": "wezterm start --class float -- sh -c 'nh os switch --update; pkill -RTMIN+12 waybar; echo Done, press Enter; read -r _'",
    "signal": 12,
  },
  "memory": {
    "interval": 5,
    "format": "<span color='#df6124'>mem</span> {percentage:02}%",
    "tooltip-format": "Used {percentage}%\n{used:0.1f}GB/{total:0.1f}GB",
    "on-click": "wezterm start --class float btop",
    "states": {
      "warning": 50,
      "critical": 80,
    },
  },
  "clock": {
    "format": "<span color='#df6124'>{0:%H:%M}</span> <span size='small' color='#616367'><i>{0:%a, %b %d}</i></span>",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#df6124'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
  },
  "pulseaudio#input": {
    "format": "<span color='#df6124'>mic</span> {format_source}",
    "format-source": "{volume}%",
    "format-source-muted": "muted",
    "tooltip-format": "mic {source_volume}%",
    "scroll-step": 1,
    "smooth-scrolling-threshold": 1,
    "on-click": "pavucontrol --tab=4",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
  },
  "pulseaudio#output": {
    "format": "<span color='#df6124'>vol</span> {volume}%",
    "format-muted": "<span color='#df6124'>vol</span> muted",
    "tooltip-format": "vol {volume}%",
    "max-volume": 100,
    "scroll-step": 2,
    "smooth-scrolling-threshold": 1,
    "on-click": "pavucontrol --tab=3",
    "on-click-middle": "$DOTFILES_DIR/scripts/switch-audio-output-simple.sh",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
  },
  "custom/media": {
    "exec": "$DOTFILES_DIR/scripts/waybar-media.sh",
    "return-type": "json",
    "interval": 3,
    "signal": 13,
    "format": "{icon}{text}",
    "format-icons": {
      "playing": "",
      "paused": "<span color='#df6124'>paused</span> ",
      "idle": "",
    },
    "max-length": 90,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "smooth-scrolling-threshold": 2,
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip-format-activated": "Stay Awake: ON",
    "tooltip-format-deactivated": "Stay Awake: OFF",
    "format-icons": {
      "activated": "󰛨",
      "deactivated": "󰛩",
    },
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray"],
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
  },
  "tray": {
    "icon-size": 13,
    "spacing": 2,
  },
}
