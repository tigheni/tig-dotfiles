# Mako notifications: soft rounded cards with a hairline border, the app
# icon on the left and the app name as a quiet footer.
# scripts/mako-launch.sh swaps these default colours for the matugen palette
# and runs mako from a copy in $XDG_RUNTIME_DIR. Each default hex stands for
# one palette role, so keep them distinct:
#   #24273a surface_container_high   #cdd6f4 on_surface
#   #a6adc8 on_surface_variant       #6c7086 outline
#   #f38ba8 error

font=Inter, JetBrainsMono Nerd Font 10
background-color=#24273af2
text-color=#cdd6f4
border-color=#cdd6f41f
progress-color=over #cdd6f414
border-size=1
border-radius=18
padding=14,16
margin=8
outer-margin=36,0,0,0
anchor=top-right
width=360
height=160
max-visible=4
sort=-time
layer=overlay
default-timeout=5000
# The dashboard lists these (makoctl history).
max-history=30
icons=1
icon-path=/run/current-system/sw/share/icons/hicolor:/etc/profiles/per-user/tig/share/icons/hicolor
max-icon-size=40
icon-location=left
icon-border-radius=10
group-by=app-name
format=<span weight="600">%s</span>\n<span color="#a6adc8">%b</span>\n<span size="small" color="#6c7086">%a</span>

[grouped]
format=<span weight="600">%s</span>\n<span color="#a6adc8">%b</span>\n<span size="small" color="#6c7086">%a · %g</span>

[urgency=low]
default-timeout=3000

[urgency=critical]
border-color=#f38ba880
default-timeout=0

# Toggled from the dashboard: notifications are hidden but still land in
# the history, so the dashboard shows what you missed.
[mode=do-not-disturb]
invisible=1
